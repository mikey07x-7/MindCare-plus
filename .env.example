# Backend
PORT=8000
HOST=0.0.0.0

# Firebase (service account JSON path or full JSON)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# JWT
JWT_SECRET=supersecretjwtkey
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# Email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# Groq API (replace with actual)
GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/v1/your-endpoint

# Storage (optional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mindcare-uploads

# Model paths
MODEL_DIR=./models
LSTM_MODEL_PATH=./models/lstm_emotion.pt
TRANSFORMER_MODEL_PATH=./models/transformer_sentiment.pt

# Flower (Federated learning) config
FLOWER_SERVER_ADDRESS=0.0.0.0:8080
